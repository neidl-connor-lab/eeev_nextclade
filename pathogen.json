{
  "$schema": "https://raw.githubusercontent.com/nextstrain/nextclade/refs/heads/release/packages/nextclade-schemas/input-pathogen-json.schema.json",
  "schemaVersion": "3.0.0",
  "files": {
    "reference": "KX029260.fa",
    "pathogenJson": "pathogen.json",
    "genomeAnnotation": "eee_KX029260_cds.gff3",
    "treeJson": "eee_tree.json",
    "examples": "sequences.fasta",
    "readme": "README.md",
    "changelog": "CHANGELOG.md"
  },
  "attributes": {
    "name": "Eastern Equine Encephalitis Virus",
    "reference name": "EEEV/Culiseta melanura/USA/SL14-0411-C/2014",
    "reference accession": "KX029260.1"
  },
  "qc": {
    "missingData": {
      "enabled": true,
      "missingDataThreshold": 2000,
      "scoreBias": 500
    },
    "snpClusters": {
      "enabled": true,
      "windowSize": 100,
      "clusterCutOff": 6,
      "scoreWeight": 50
    },
    "mixedSites": {
      "enabled": true,
      "mixedSitesThreshold": 15
    },
    "frameShifts": {
      "enabled": true,
      "scoreWeight": 20
    },
    "stopCodons": {
      "enabled": true,
      "scoreWeight": 50
    }
  }
}